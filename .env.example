# Copy this file to .env (and never commit the real .env) or set these as
# real environment variables / GitHub Actions secrets.

NEWSLETTER_URL=https://app.smore.com/n/dpguw

# Recipient / sender
EMAIL_TO=rtwilliamson@gmail.com
EMAIL_FROM=

# SMTP credentials (Gmail example: smtp.gmail.com / 587 with an App Password
# from https://myaccount.google.com/apppasswords - a regular Gmail password
# will not work)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional: if set, Claude turns the raw scrape into a clean bullet-point
# digest. If unset, a simpler heuristic extractor is used instead.
ANTHROPIC_API_KEY=
