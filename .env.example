# Copy this file to .env (and never commit the real .env) or set these as
# real environment variables / GitHub Actions secrets & variables.

# Sender address of the ParentSquare email announcing a new newsletter issue.
NEWSLETTER_SENDER=donotreply+c75680a1-bc11-5aab-8d22-8381a21f2834@parentsquare.com

# IMAP (reads your inbox to find the current issue's link)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Recipient / sender
EMAIL_TO=rtwilliamson@gmail.com
EMAIL_FROM=

# SMTP credentials — also reused for IMAP above (same Gmail App Password
# works for both). Gmail example: smtp.gmail.com / 587. Generate an App
# Password at https://myaccount.google.com/apppasswords — a regular Gmail
# password will not work for either SMTP or IMAP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Where the last-processed issue's flyer slug is recorded, so the same issue
# isn't re-sent on every scheduled run.
STATE_FILE=.state/last_slug.txt

# Optional: if set, Claude turns the raw scrape into a clean bullet-point
# digest. If unset, a simpler heuristic extractor is used instead.
ANTHROPIC_API_KEY=
